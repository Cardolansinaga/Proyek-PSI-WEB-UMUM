APP_NAME="SMAN 2 Balige"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
SEED_DEMO_CONTENT=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_FORCE_HTTPS=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sman2_balige
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="website@sman2balige.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_NAME="Admin Utama"
ADMIN_EMAIL=admin@sman2balige.sch.id
ADMIN_INITIAL_PASSWORD=
