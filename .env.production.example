APP_NAME="SMAN 2 Balige"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
SEED_DEMO_CONTENT=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://www.sman2balige.sch.id
APP_FORCE_HTTPS=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sman2_balige_production
DB_USERNAME=sman2_balige_app
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.provider-sekolah.id
MAIL_PORT=587
MAIL_USERNAME=website@sman2balige.sch.id
MAIL_PASSWORD=GANTI_DENGAN_PASSWORD_SMTP
MAIL_FROM_ADDRESS=website@sman2balige.sch.id
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_NAME="Admin Utama"
ADMIN_EMAIL=admin@sman2balige.sch.id
ADMIN_INITIAL_PASSWORD=GANTI_DENGAN_PASSWORD_UNIK_MINIMAL_16_KARAKTER
